import CryptWalker.Sign.Ed25519_facts

/-! # The field identities behind the Edwards/Montgomery transport

Each lemma is a polynomial identity over `ZMod p`, proved by `linear_combination` against the
curve relations `v² = u³ + 486662u² + u`, `c² = -486664`. The cofactors were computed by
reducing the cleared-denominator goal modulo those (monic) relations, so they are exact.

`u, v` are Curve25519 coordinates; the Edwards point they map to is
`(x, y) = (-c·u/v, (u-1)/(u+1))`. -/

namespace CryptWalker.Sign.Ed25519Identities

open CryptWalker.Sign.Ed25519Facts

/-- The map lands on the Edwards curve. -/
lemma psi_curve_aux (u v : F) (hv : v ^ 2 = u ^ 3 + 486662 * u ^ 2 + u) (hv0 : v ≠ 0) (hu1 : u + 1 ≠ 0) :
    -(-c * u / v) ^ 2 + ((u - 1) / (u + 1)) ^ 2 = 1 + d * (-c * u / v) ^ 2 * ((u - 1) / (u + 1)) ^ 2 := by
  field_simp
  linear_combination (-u^2*((u+1)^2 + d*(u-1)^2)) * c_sq + (4*u^2*(u-1)^2) * d_rel + (-4*u) * hv

/-- Generic addition (`u₁ ≠ u₂`), `y`-coordinate. -/
lemma gen_y (u1 u2 v1 v2 : F) (hv1 : v1 ^ 2 = u1 ^ 3 + 486662 * u1 ^ 2 + u1)
    (hv2 : v2 ^ 2 = u2 ^ 3 + 486662 * u2 ^ 2 + u2)
    (hu : u1 - u2 ≠ 0) (hv1' : v1 ≠ 0) (hv2' : v2 ≠ 0) (hu1 : u1 + 1 ≠ 0) (hu2 : u2 + 1 ≠ 0)
    (h1t : 1 - d * (-c * u1 / v1) * (-c * u2 / v2) * ((u1 - 1) / (u1 + 1)) * ((u2 - 1) / (u2 + 1)) ≠ 0)
    (hu3 : ((v1 - v2) / (u1 - u2)) ^ 2 - 486662 - u1 - u2 + 1 ≠ 0) :
    ((u1 - 1) / (u1 + 1) * ((u2 - 1) / (u2 + 1)) + (-c * u1 / v1) * (-c * u2 / v2)) /
      (1 - d * (-c * u1 / v1) * (-c * u2 / v2) * ((u1 - 1) / (u1 + 1)) * ((u2 - 1) / (u2 + 1)))
    = (((v1 - v2) / (u1 - u2)) ^ 2 - 486662 - u1 - u2 - 1) /
      (((v1 - v2) / (u1 - u2)) ^ 2 - 486662 - u1 - u2 + 1) := by
  rw [div_eq_div_iff h1t hu3]
  have := h121666
  unfold d
  field_simp
  linear_combination (-u1^5*u2^2 - 243331*u1^5*u2 + u1^4*u2^3 - 243331*u1^4*u2^2 - 118419951122*u1^4*u2 + u1^3*u2^4 + 973324*u1^3*u2^3 + 118419951122*u1^3*u2^2 - 243331*u1^3*u2 - u1^2*u2^5 - 243331*u1^2*u2^4 + 118419951122*u1^2*u2^3 + u1^2*u2^2*v1^2 - 2*u1^2*u2^2*v1*v2 + u1^2*u2^2*v2^2 + 486662*u1^2*u2^2 + 243331*u1^2*u2*v1^2 - 486662*u1^2*u2*v1*v2 + 243331*u1^2*u2*v2^2 - 243331*u1*u2^5 - 118419951122*u1*u2^4 - 243331*u1*u2^3 + 243331*u1*u2^2*v1^2 - 486662*u1*u2^2*v1*v2 + 243331*u1*u2^2*v2^2 + u1*u2*v1^2 - 2*u1*u2*v1*v2 + u1*u2*v2^2) * c_sq + (-486664*u1^2*u2^2 - 118420437784*u1^2*u2 - 118420437784*u1*u2^2 - 486664*u1*u2 - 243332*u1*v1*v2 + 486664*u1*v2^2 - 243332*u2*v1*v2 + 486664*u2*v2^2) * hv1 + (486664*u1^4 + 486664*u1^3*u2 + 236840875568*u1^3 - 486664*u1^2*u2^2 + 118420437784*u1^2*u2 + 486664*u1^2 - 118420437784*u1*u2^2 - 243332*u1*v1*v2 - 243332*u2*v1*v2) * hv2

/-- Generic addition (`u₁ ≠ u₂`), `x`-coordinate. -/
lemma gen_x (u1 u2 v1 v2 : F) (hv1 : v1 ^ 2 = u1 ^ 3 + 486662 * u1 ^ 2 + u1)
    (hv2 : v2 ^ 2 = u2 ^ 3 + 486662 * u2 ^ 2 + u2)
    (hu : u1 - u2 ≠ 0) (hv1' : v1 ≠ 0) (hv2' : v2 ≠ 0) (hu1 : u1 + 1 ≠ 0) (hu2 : u2 + 1 ≠ 0)
    (h1t : 1 + d * (-c * u1 / v1) * (-c * u2 / v2) * ((u1 - 1) / (u1 + 1)) * ((u2 - 1) / (u2 + 1)) ≠ 0)
    (hv3 : -((((v1 - v2) / (u1 - u2)) * ((((v1 - v2) / (u1 - u2)) ^ 2 - 486662 - u1 - u2) - u1)) + v1) ≠ 0) :
    ((-c * u1 / v1) * ((u2 - 1) / (u2 + 1)) + ((u1 - 1) / (u1 + 1)) * (-c * u2 / v2)) /
      (1 + d * (-c * u1 / v1) * (-c * u2 / v2) * ((u1 - 1) / (u1 + 1)) * ((u2 - 1) / (u2 + 1)))
    = -c * (((v1 - v2) / (u1 - u2)) ^ 2 - 486662 - u1 - u2) /
      (-((((v1 - v2) / (u1 - u2)) * ((((v1 - v2) / (u1 - u2)) ^ 2 - 486662 - u1 - u2) - u1)) + v1)) := by
  rw [div_eq_div_iff h1t hv3]
  have := h121666
  unfold d
  field_simp
  linear_combination (121665*c*u1^6*u2^2 - 121665*c*u1^6*u2 - 243330*c*u1^5*u2^3 + 59209853895*c*u1^5*u2^2 - 59209610565*c*u1^5*u2 - 177628953360*c*u1^4*u2^3 + 118419221130*c*u1^4*u2^2 + 59209732230*c*u1^4*u2 + 243330*c*u1^3*u2^5 + 177628953360*c*u1^3*u2^4 - 121665*c*u1^3*u2^2*v1^2 + 243330*c*u1^3*u2^2*v1*v2 - 121665*c*u1^3*u2^2*v2^2 - 177629196690*c*u1^3*u2^2 + 121665*c*u1^3*u2*v1^2 - 243330*c*u1^3*u2*v1*v2 + 121665*c*u1^3*u2*v2^2 - 121665*c*u1^2*u2^6 - 59209853895*c*u1^2*u2^5 - 118419221130*c*u1^2*u2^4 + 121665*c*u1^2*u2^3*v1^2 - 243330*c*u1^2*u2^3*v1*v2 + 121665*c*u1^2*u2^3*v2^2 + 177629196690*c*u1^2*u2^3 - 121665*c*u1^2*u2*v1^2 + 243330*c*u1^2*u2*v1*v2 - 121665*c*u1^2*u2*v2^2 + 121665*c*u1*u2^6 + 59209610565*c*u1*u2^5 - 59209732230*c*u1*u2^4 - 121665*c*u1*u2^3*v1^2 + 243330*c*u1*u2^3*v1*v2 - 121665*c*u1*u2^3*v2^2 + 121665*c*u1*u2^2*v1^2 - 243330*c*u1*u2^2*v1*v2 + 121665*c*u1*u2^2*v2^2) * c_sq + (59209975560*c*u1^3*u2^2 - 59209975560*c*u1^3*u2 + 364998*c*u1^2*u2^4 + 59210827222*c*u1^2*u2^3 + 118420559450*c*u1^2*u2^2 + 243332*c*u1^2*u2*v1*v2 - 608330*c*u1^2*u2*v2^2 + 59210097226*c*u1^2*u2 + 121666*c*u1^2*v2^2 - 243332*c*u1*u2^5 - 59210827222*c*u1*u2^4 - 118421046114*c*u1*u2^3 + 121666*c*u1*u2^2*v1^2 - 486664*c*u1*u2^2*v1*v2 + 608330*c*u1*u2^2*v2^2 - 177630535010*c*u1*u2^2 + 121666*c*u1*u2*v1^2 - 243332*c*u1*u2*v1*v2 - 121666*c*u1*u2 + 121666*c*u1*v2^2 + 243332*c*u2^5 + 59210462224*c*u2^4 + 59210218892*c*u2^3 - 121666*c*u2^2*v1^2 + 243332*c*u2^2*v1*v2 - 121666*c*u2^2*v2^2 - 121666*c*u2*v1^2 + 243332*c*u2*v1*v2 - 121666*c*u2*v2^2) * hv1 + (-364998*c*u1^5*u2 - 121666*c*u1^5 + 243332*c*u1^4*u2^2 - 236840267238*c*u1^4*u2 - 121666*c*u1^4 + 236840145572*c*u1^3*u2^2 + 118420316118*c*u1^3*u2 + 121666*c*u1^3 - 59209975560*c*u1^2*u2^3 - 177630170012*c*u1^2*u2^2 + 486664*c*u1^2*u2*v1*v2 - 121666*c*u1^2*u2*v2^2 + 118420316118*c*u1^2*u2 - 243332*c*u1^2*v1*v2 + 121666*c*u1^2*v2^2 + 121666*c*u1^2 + 59209975560*c*u1*u2^3 - 243332*c*u1*u2^2*v1*v2 - 59210218892*c*u1*u2^2 + 243332*c*u1*u2*v1*v2 - 121666*c*u1*u2*v2^2 - 243332*c*u1*v1*v2 + 121666*c*u1*v2^2) * hv2

/-- Doubling, `y`-coordinate and `x`-coordinate. -/
lemma dbl_y (u v : F) (hv : v ^ 2 = u ^ 3 + 486662 * u ^ 2 + u)
    (hv' : v ≠ 0) (hu : u + 1 ≠ 0)
    (h1t : 1 - d * (-c * u / v) * (-c * u / v) * ((u - 1) / (u + 1)) * ((u - 1) / (u + 1)) ≠ 0)
    (hu3 : ((3 * u ^ 2 + 973324 * u + 1) / (2 * v)) ^ 2 - 486662 - u - u + 1 ≠ 0) :
    ((u - 1) / (u + 1) * ((u - 1) / (u + 1)) + (-c * u / v) * (-c * u / v)) /
      (1 - d * (-c * u / v) * (-c * u / v) * ((u - 1) / (u + 1)) * ((u - 1) / (u + 1)))
    = (((3 * u ^ 2 + 973324 * u + 1) / (2 * v)) ^ 2 - 486662 - u - u - 1) /
      (((3 * u ^ 2 + 973324 * u + 1) / (2 * v)) ^ 2 - 486662 - u - u + 1) := by
  rw [div_eq_div_iff h1t hu3]
  have := h121666
  have h2 := two_ne
  unfold d
  field_simp
  linear_combination (9*u^8 + 10219902*u^7 + 3789438435919*u^6 - 8*u^5*v^2 + 461043922034184676*u^5 - 4866620*u^4*v^2 + 1894719217959*u^4 - 947359608976*u^3*v^2 + 2433310*u^3 - 973324*u^2*v^2 + u^2) * c_sq + (4379976*u^5 + 2842090506816*u^4 + 461045816745616048*u^3 + 4866640*u^2*v^2 + 947363502272*u^2 + 947363502272*u*v^2 + 486664*u + 973328*v^2) * hv

lemma dbl_x (u v : F) (hv : v ^ 2 = u ^ 3 + 486662 * u ^ 2 + u)
    (hv' : v ≠ 0) (hu : u + 1 ≠ 0)
    (h1t : 1 + d * (-c * u / v) * (-c * u / v) * ((u - 1) / (u + 1)) * ((u - 1) / (u + 1)) ≠ 0)
    (hv3 : -((((3 * u ^ 2 + 973324 * u + 1) / (2 * v))) * ((((3 * u ^ 2 + 973324 * u + 1) / (2 * v)) ^ 2 - 486662 - u - u) - u) + v) ≠ 0) :
    ((-c * u / v) * ((u - 1) / (u + 1)) + ((u - 1) / (u + 1)) * (-c * u / v)) /
      (1 + d * (-c * u / v) * (-c * u / v) * ((u - 1) / (u + 1)) * ((u - 1) / (u + 1)))
    = -c * (((3 * u ^ 2 + 973324 * u + 1) / (2 * v)) ^ 2 - 486662 - u - u) /
      (-((((3 * u ^ 2 + 973324 * u + 1) / (2 * v))) * ((((3 * u ^ 2 + 973324 * u + 1) / (2 * v)) ^ 2 - 486662 - u - u) - u) + v)) := by
  rw [div_eq_div_iff h1t hv3]
  have := h121666
  have h2 := two_ne
  unfold d
  field_simp
  linear_combination (-2189970*c*u^8 - 1421029193580*c*u^7 - 230518171588632990*c*u^6 + 1946640*c*u^5*v^2 + 461040132595748760*c*u^5 + 473673964560*c*u^4*v^2 - 230520066298117710*c*u^4 - 947353769040*c*u^3*v^2 - 473677371180*c*u^3 + 473677857840*c*u^2*v^2 - 243330*c*u^2) * c_sq + (-6569964*c*u^6 - 4263131380248*c*u^5 - 691565883025727268*c*u^4 + 461045816745616048*c*u^3 - 473685644448*c*u^2*v^2 + 230523855735580300*c*u^2 - 947367395584*c*u*v^2 + 473682237800*c*u - 473681751136*c*v^2 + 243332*c) * hv

end CryptWalker.Sign.Ed25519Identities
