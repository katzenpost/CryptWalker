import Lean.Data.Json
import Cryptlib.Primitives.KEM.MLKEMHedged.MLKEMHedged512
import Cryptlib.Primitives.KEM.MLKEMHedged.MLKEMHedged768
import Cryptlib.Primitives.KEM.MLKEMHedged.MLKEMHedged1024
import Cryptlib.Util.newhex

/-! # Hedged ML-KEM vector generator

Writes random vectors in the schema `mlkem_hedged_test.lean` checks, each decapsulated before it is
written. With no arguments it writes all three parameter sets; otherwise only the sizes given, e.g.
`512 1024`. -/

open Lean
open MLKEM
open Cryptlib.Primitives.KEM.FIPS203 (hashH uBytes vBytes)
open Cryptlib.Primitives.KEM.MLKEMHedged
open Cryptlib.Util.newhex
open Cryptlib.Util.Bytes (ofVector toVecN)

def hexOfB (b : ByteArray) : String := byteArrayToHex b

def randomVector (n : Nat) : IO (Vector UInt8 n) := do
  let bs ← IO.getRandomBytes (USize.ofNat n)
  pure (Vector.ofFn fun i : Fin n => bs[i.val]!)

def buildVec (ps : ParameterSet) (name : String) : IO Json := do
  let K := kemSeed ps
  let d ← randomVector 32
  let z ← randomVector 32
  let m ← randomVector 32
  let sk := (d, z)
  let pk := K.derivePublicKey sk
  let (ss, ct) := encapsHedged ps (show Cryptlib.Primitives.KEM.FIPS203.PublicKey ps from pk).1 m
  let ctBytes := uBytes ps ct.uEncoded ++ vBytes ps ct.vEncoded
  let some c := K.decodeCiphertext (toVecN _ ctBytes)
    | throw (IO.userError "ciphertext decode failed")
  match K.decap sk c K.stateI.default with
  | .ok k _ =>
    if hexOfB (ofVector (K.encodePlaintext k)) ≠ hexOfB (ofVector ss) then
      throw (IO.userError s!"{name}: decapsulation mismatch")
  | .error _ _ => throw (IO.userError s!"{name}: decapsulation failed")
  pure (Json.mkObj [
    ("name", Json.str name),
    ("d_hex", Json.str (hexOfB (ofVector d))),
    ("z_hex", Json.str (hexOfB (ofVector z))),
    ("m_hex", Json.str (hexOfB (ofVector m))),
    ("m_hash_hex", Json.str (hexOfB (ofVector (hashH (ofVector m))))),
    ("encapsulation_key_hex", Json.str (hexOfB (ofVector (K.encodePublicKey pk)))),
    ("ciphertext_hex", Json.str (hexOfB ctBytes)),
    ("shared_secret_hex", Json.str (hexOfB (ofVector ss)))])

def parameterSet : String → Option ParameterSet
  | "512" => some .MLKEM512
  | "768" => some .MLKEM768
  | "1024" => some .MLKEM1024
  | _ => none

def generate (size : String) (ps : ParameterSet) : IO Unit := do
  let names := ["lean_case_1", "lean_case_2", "lean_case_3", "lean_case_4", "lean_case_5"]
  let vecs ← names.toArray.mapM (buildVec ps)
  let out := Json.mkObj [
    ("format_version", Json.num 1),
    ("generator", Json.str "Cryptlib/Primitives/KEM/gen_mlkem_hedged_vectors.lean"),
    ("primitive", Json.str s!"mlkem{size}_hedged"),
    ("description", Json.str s!"Hedged ML-KEM-{size} (FIPS 203 ML-KEM-{size} with round-3 Kyber's pre-hash of m restored, H = SHA3-256), generated by the Lean port's kemSeed and encapsHedged for cross-checking against hpqc's MLKEMHedged{size}."),
    ("vectors", Json.arr vecs)]
  let outPath := s!"testdata/lean_mlkem{size}_hedged_vectors.json"
  IO.FS.writeFile outPath out.pretty
  IO.println s!"wrote {outPath}"

def main (args : List String) : IO UInt32 := do
  let sizes := if args.isEmpty then ["512", "768", "1024"] else args
  for size in sizes do
    match parameterSet size with
    | some ps => generate size ps
    | none => IO.eprintln s!"unknown ML-KEM size: {size}"; return 1
  pure 0
